{
  "$schema": "https://raw.githubusercontent.com/VitexSoftware/php-vitexsoftware-multiflexi-core/refs/heads/main/schema/application.json",
  "schemaVersion": "3.4.0",
  "version": "1.0.2",
  "uuid": "51b42eb3-ef0a-48b2-81ba-17c270229594",
  "name": {
    "en": "Fio Statement Downloader",
    "cs": "Stahovač Fio výpisů"
  },
  "description": {
    "en": "Download FioBank statements to disk",
    "cs": "Stáhnout FioBank výpisy na disk"
  },
  "requirements": [
    "FioBank"
  ],
  "tags": [
    "FioBank",
    "Statements",
    "Downloader"
  ],
  "homepage": "https://github.com/Spoje-NET/fiobank-statement-tools",
  "ociimage": "dockerhub.io/spojenet/fiobank-statement-downloader",
  "executable": "fiobank-statement-downloader",
  "events": {
    "emits": {
      "bank.statement.downloaded": {
        "description": "A bank statement file was downloaded"
      }
    }
  },
  "environment": {
    "FIO_TOKEN": {
      "type": "password",
      "description": {
        "en": "Token with account read permission",
        "cs": "Token s oprávněním pro čtení účtu"
      },
      "defval": "",
      "required": true,
      "category": "Security"
    },
    "FIO_TOKEN_NAME": {
      "type": "string",
      "description": {
        "en": "Name of Token used",
        "cs": "Název použitého tokenu"
      },
      "defval": "",
      "required": true,
      "category": "Security"
    },
    "ACCOUNT_NUMBER": {
      "type": "string",
      "description": {
        "en": "Number of Account",
        "cs": "Číslo účtu"
      },
      "defval": "",
      "required": true,
      "category": "Other"
    },
    "STATEMENTS_DIR": {
      "type": "string",
      "description": {
        "en": "Directory to download",
        "cs": "Adresář pro stažení"
      },
      "defval": ".",
      "required": true,
      "category": "Other"
    },
    "STATEMENTS_FORMAT": {
      "type": "string",
      "description": {
        "en": "(default) pdf, csv, gpc, html, json, ofx, xml",
        "cs": "(výchozí) pdf, csv, gpc, html, json, ofx, xml"
      },
      "defval": "pdf",
      "options": [
        "pdf",
        "csv",
        "gpc",
        "html",
        "json",
        "ofx",
        "xml"
      ],
      "required": true,
      "category": "Other"
    },
    "EASE_LOGGER": {
      "type": "string",
      "description": {
        "en": "write log messages using",
        "cs": "zapisovat log zprávy pomocí"
      },
      "defval": "console|syslog",
      "required": false,
      "category": "Behavior"
    },
    "LANG": {
      "type": "set",
      "description": {
        "en": "Locale for this application",
        "cs": "Lokalizace pro tuto aplikaci"
      },
      "defval": "cs_CZ",
      "required": false,
      "options": [
        "cs_CZ",
        "en_US"
      ],
      "category": "Other"
    }
  },
  "exitCodes": {
    "0": {
      "description": {
        "en": "Success",
        "cs": "Úspěch"
      },
      "severity": "success",
      "retry": false
    },
    "1": {
      "description": {
        "en": "General error",
        "cs": "Obecná chyba"
      },
      "severity": "error",
      "retry": true
    },
    "3": {
      "description": {
        "en": "Rate limit - one API call per token every 30 seconds",
        "cs": "Limit API - jedno volání na token každých 30 sekund"
      },
      "severity": "warning",
      "retry": true
    },
    "4": {
      "description": {
        "en": "Not found - resource does not exist",
        "cs": "Nenalezeno - zdroj neexistuje"
      },
      "severity": "error",
      "retry": true
    },
    "5": {
      "description": {
        "en": "Statement not yet available (not generated) or invalid token",
        "cs": "Výpis zatím není k dispozici (nebyl vygenerován) nebo neplatný token"
      },
      "severity": "warning",
      "retry": true
    }
  }
}
