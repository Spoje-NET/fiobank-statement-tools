{
  "$schema": "https://raw.githubusercontent.com/VitexSoftware/php-vitexsoftware-multiflexi-core/refs/heads/main/schema/application.json",
  "schemaVersion": "3.4.0",
  "version": "1.0.2",
  "uuid": "3d987aa7-906c-4a23-894e-bf160c2780f0",
  "name": {
    "en": "Fio transaction report",
    "cs": "Report transakcí FioBank"
  },
  "description": {
    "en": "FioBank transaction report",
    "cs": "FioBank transakce report"
  },
  "requirements": [
    "FioBank"
  ],
  "tags": [
    "FioBank",
    "Transactions",
    "Json",
    "Report",
    "Check"
  ],
  "homepage": "https://github.com/Spoje-NET/fiobank-statement-tools",
  "executable": "fiobank-transaction-report",
  "events": {
    "consumes": {
      "bank.statement.downloaded": {
        "description": "A bank statement file was downloaded",
        "format": "file"
      }
    },
    "emits": {
      "bank.transaction.reported": {
        "description": "A bank transaction report was produced"
      }
    }
  },
  "environment": {
    "FIO_TOKEN": {
      "type": "password",
      "description": {
        "en": "Token with account read permission",
        "cs": "Token s oprávněním pro čtení účtu"
      },
      "defval": "",
      "required": true,
      "category": "Security"
    },
    "FIO_TOKEN_NAME": {
      "type": "string",
      "description": {
        "en": "Name of Token used",
        "cs": "Název použitého tokenu"
      },
      "defval": "",
      "required": true,
      "category": "Security"
    },
    "ACCOUNT_NUMBER": {
      "type": "string",
      "description": {
        "en": "Number of Account",
        "cs": "Číslo účtu"
      },
      "defval": "",
      "required": true,
      "category": "Other"
    },
    "TRANSACTION_SCOPE": {
      "type": "string",
      "description": {
        "en": "Time scope of transactions downloaded",
        "cs": "Časový rozsah stahovaných transakcí"
      },
      "defval": "last_month",
      "required": false,
      "category": "Other"
    },
    "RESULT_FILE": {
      "type": "string",
      "description": {
        "en": "write output json data to",
        "cs": "zapsat výstupní json data do"
      },
      "defval": "transaction_report.json",
      "required": false,
      "category": "Other"
    },
    "EASE_LOGGER": {
      "type": "string",
      "description": {
        "en": "write log messages using",
        "cs": "zapisovat log zprávy pomocí"
      },
      "defval": "console|syslog",
      "required": false,
      "category": "Behavior"
    },
    "LANG": {
      "type": "set",
      "description": {
        "en": "Locale for this application",
        "cs": "Lokalizace pro tuto aplikaci"
      },
      "defval": "cs_CZ",
      "required": false,
      "options": [
        "cs_CZ",
        "en_US"
      ],
      "category": "Other"
    }
  },
  "exitCodes": {
    "0": {
      "description": {
        "en": "Success",
        "cs": "Úspěch"
      },
      "severity": "success",
      "retry": false
    },
    "1": {
      "description": {
        "en": "General error",
        "cs": "Obecná chyba"
      },
      "severity": "error",
      "retry": true
    },
    "3": {
      "description": {
        "en": "Rate limit - one API call per token every 30 seconds",
        "cs": "Limit API - jedno volání na token každých 30 sekund"
      },
      "severity": "warning",
      "retry": true
    },
    "4": {
      "description": {
        "en": "Not found - resource does not exist",
        "cs": "Nenalezeno - zdroj neexistuje"
      },
      "severity": "error",
      "retry": true
    },
    "5": {
      "description": {
        "en": "Statement not yet available (not generated) or invalid token",
        "cs": "Výpis zatím není k dispozici (nebyl vygenerován) nebo neplatný token"
      },
      "severity": "warning",
      "retry": true
    }
  }
}
